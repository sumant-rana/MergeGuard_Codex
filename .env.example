# Server
PORT=4000
MERGEGUARD_PUBLIC_URL=http://localhost:4000
MERGEGUARD_DATA_FILE=./data/mergeguard.json
MERGEGUARD_CHECK_MODE=advisory

# GitHub webhook security
# Use the same secret configured in the GitHub App webhook settings.
GITHUB_WEBHOOK_SECRET=change-me

# GitHub API access.
# For a real GitHub App, set GITHUB_APP_ID and GITHUB_APP_PRIVATE_KEY_PATH.
# For local tests against a sandbox repo, GITHUB_TOKEN is also supported.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_TOKEN=

# Local development only.
# When true, webhook fixtures can include mergeguard.changed_files instead of
# requiring a GitHub API call to fetch PR files.
MERGEGUARD_ALLOW_FIXTURE_FILES=true

# Production note:
# Set MERGEGUARD_ALLOW_FIXTURE_FILES=false outside local development.
# In blocking mode, policy, prompt canary, contract, and evidence blockers can
# produce failing GitHub checks.
